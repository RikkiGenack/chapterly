# Server
PORT=4000

# PostgreSQL (required for auth, journal CRUD, and photo metadata)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Auth — change JWT_SECRET in production
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (free tier) — photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI — journal prompt + text enhancement
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Unsplash — stock image search for chapter/scrapbook visuals
UNSPLASH_ACCESS_KEY=
